{
  "name": "Bundle",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u041d\u0430\u0437\u0432\u0430"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "tier": {
      "type": "string",
      "title": "\u0422\u0456\u0440",
      "enum": [
        "base",
        "comfort",
        "complete"
      ],
      "default": "base"
    },
    "description": {
      "type": "string",
      "title": "\u041e\u043f\u0438\u0441"
    },
    "image": {
      "type": "string",
      "title": "\u0417\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "qty": {
            "type": "number",
            "default": 1
          }
        }
      },
      "title": "\u0422\u043e\u0432\u0430\u0440\u0438"
    },
    "discountType": {
      "type": "string",
      "title": "\u0422\u0438\u043f \u0437\u043d\u0438\u0436\u043a\u0438",
      "enum": [
        "percent",
        "fixed"
      ],
      "default": "percent"
    },
    "discountValue": {
      "type": "number",
      "title": "\u0417\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u043d\u0438\u0436\u043a\u0438",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "title": "\u0410\u043a\u0442\u0438\u0432\u043d\u0438\u0439",
      "default": true
    },
    "startDate": {
      "type": "string",
      "format": "date-time",
      "title": "\u0414\u0430\u0442\u0430 \u043f\u043e\u0447\u0430\u0442\u043a\u0443"
    },
    "endDate": {
      "type": "string",
      "format": "date-time",
      "title": "\u0414\u0430\u0442\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044f"
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}