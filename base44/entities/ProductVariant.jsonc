{
  "name": "ProductVariant",
  "type": "object",
  "properties": {
    "productId": {
      "type": "string",
      "title": "Product ID"
    },
    "variantSKU": {
      "type": "string",
      "title": "Variant SKU"
    },
    "size": {
      "type": "string",
      "title": "\u0420\u043e\u0437\u043c\u0456\u0440"
    },
    "fabricId": {
      "type": "string",
      "title": "\u0422\u043a\u0430\u043d\u0438\u043d\u0430 ID"
    },
    "color": {
      "type": "string",
      "title": "\u041a\u043e\u043b\u0456\u0440"
    },
    "headboard": {
      "type": "string",
      "title": "\u0421\u043f\u0438\u043d\u043a\u0430"
    },
    "mechanism": {
      "type": "string",
      "title": "\u041c\u0435\u0445\u0430\u043d\u0456\u0437\u043c",
      "enum": [
        "none",
        "lifting"
      ],
      "default": "none"
    },
    "priceAdjustment": {
      "type": "number",
      "title": "\u041a\u043e\u0440\u0438\u0433\u0443\u0432\u0430\u043d\u043d\u044f \u0446\u0456\u043d\u0438",
      "default": 0
    },
    "finalPrice": {
      "type": "number",
      "title": "\u0424\u0456\u043d\u0430\u043b\u044c\u043d\u0430 \u0446\u0456\u043d\u0430"
    },
    "oldPrice": {
      "type": "number",
      "title": "\u0421\u0442\u0430\u0440\u0430 \u0446\u0456\u043d\u0430"
    },
    "availability": {
      "type": "string",
      "title": "\u041d\u0430\u044f\u0432\u043d\u0456\u0441\u0442\u044c",
      "enum": [
        "in_stock",
        "made_to_order",
        "out_of_stock"
      ],
      "default": "made_to_order"
    },
    "productionTime": {
      "type": "string",
      "title": "\u0422\u0435\u0440\u043c\u0456\u043d \u0432\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u043d\u044f"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0417\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f"
    },
    "active": {
      "type": "boolean",
      "title": "\u0410\u043a\u0442\u0438\u0432\u043d\u0438\u0439",
      "default": true
    }
  },
  "required": [
    "productId",
    "variantSKU"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}