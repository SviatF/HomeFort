{
  "name": "Order",
  "type": "object",
  "properties": {
    "orderNumber": {
      "type": "string",
      "title": "\u041d\u043e\u043c\u0435\u0440 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f"
    },
    "customerName": {
      "type": "string",
      "title": "\u0406\u043c'\u044f"
    },
    "phone": {
      "type": "string",
      "title": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "city": {
      "type": "string",
      "title": "\u041c\u0456\u0441\u0442\u043e"
    },
    "deliveryMethod": {
      "type": "string",
      "title": "\u0421\u043f\u043e\u0441\u0456\u0431 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438"
    },
    "address": {
      "type": "string",
      "title": "\u0412\u0456\u0434\u0434\u0456\u043b\u0435\u043d\u043d\u044f / \u0430\u0434\u0440\u0435\u0441\u0430"
    },
    "paymentMethod": {
      "type": "string",
      "title": "\u0421\u043f\u043e\u0441\u0456\u0431 \u043e\u043f\u043b\u0430\u0442\u0438"
    },
    "comment": {
      "type": "string",
      "title": "\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "\u0422\u043e\u0432\u0430\u0440\u0438"
    },
    "itemsTotal": {
      "type": "number",
      "title": "\u0421\u0443\u043c\u0430 \u0442\u043e\u0432\u0430\u0440\u0456\u0432",
      "default": 0
    },
    "discount": {
      "type": "number",
      "title": "\u0417\u043d\u0438\u0436\u043a\u0430",
      "default": 0
    },
    "couponCode": {
      "type": "string",
      "title": "\u041f\u0440\u043e\u043c\u043e\u043a\u043e\u0434"
    },
    "deliveryCost": {
      "type": "number",
      "title": "\u0412\u0430\u0440\u0442\u0456\u0441\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438",
      "default": 0
    },
    "total": {
      "type": "number",
      "title": "\u0420\u0430\u0437\u043e\u043c",
      "default": 0
    },
    "trackingNumber": {
      "type": "string",
      "title": "\u0422\u0440\u0435\u043a-\u043d\u043e\u043c\u0435\u0440"
    },
    "carrier": {
      "type": "string",
      "title": "\u041f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a"
    },
    "estimatedReadyDate": {
      "type": "string",
      "format": "date",
      "title": "\u041e\u0440\u0456\u0454\u043d\u0442\u043e\u0432\u043d\u0430 \u0434\u0430\u0442\u0430 \u0433\u043e\u0442\u043e\u0432\u043d\u043e\u0441\u0442\u0456"
    },
    "paidAmount": {
      "type": "number",
      "title": "\u0421\u043f\u043b\u0430\u0447\u0435\u043d\u043e",
      "default": 0
    },
    "balanceAmount": {
      "type": "number",
      "title": "\u0417\u0430\u043b\u0438\u0448\u043e\u043a",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "confirmed",
        "paid",
        "production",
        "in_production",
        "ready",
        "shipped",
        "delivered",
        "cancelled"
      ],
      "default": "new",
      "title": "\u0421\u0442\u0430\u0442\u0443\u0441"
    },
    "reviewRequested": {
      "type": "boolean",
      "title": "\u0417\u0430\u043f\u0438\u0442 \u0432\u0456\u0434\u0433\u0443\u043a\u0443 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u043d\u043e",
      "default": false
    }
  },
  "required": [
    "orderNumber",
    "customerName",
    "phone",
    "total",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}