{
  "name": "Review",
  "type": "object",
  "properties": {
    "customerName": {
      "type": "string",
      "title": "\u0406\u043c'\u044f \u043a\u043b\u0456\u0454\u043d\u0442\u0430"
    },
    "product": {
      "type": "string",
      "title": "\u0422\u043e\u0432\u0430\u0440"
    },
    "rating": {
      "type": "number",
      "title": "\u041e\u0446\u0456\u043d\u043a\u0430",
      "default": 5
    },
    "text": {
      "type": "string",
      "title": "\u0422\u0435\u043a\u0441\u0442 \u0432\u0456\u0434\u0433\u0443\u043a\u0443"
    },
    "customerPhoto": {
      "type": "string",
      "title": "\u0424\u043e\u0442\u043e \u043a\u043b\u0456\u0454\u043d\u0442\u0430"
    },
    "productPhoto": {
      "type": "string",
      "title": "\u0424\u043e\u0442\u043e \u0442\u043e\u0432\u0430\u0440\u0443 \u0432\u0434\u043e\u043c\u0430"
    },
    "city": {
      "type": "string",
      "title": "\u041c\u0456\u0441\u0442\u043e"
    },
    "purchaseDate": {
      "type": "string",
      "format": "date",
      "title": "\u0414\u0430\u0442\u0430 \u043f\u043e\u043a\u0443\u043f\u043a\u0438"
    },
    "verifiedPurchase": {
      "type": "boolean",
      "title": "\u041f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u0430 \u043f\u043e\u043a\u0443\u043f\u043a\u0430",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "title": "\u0421\u0442\u0430\u0442\u0443\u0441"
    },
    "featured": {
      "type": "boolean",
      "title": "\u0412\u0438\u0434\u0456\u043b\u0438\u0442\u0438",
      "default": false
    }
  },
  "required": [
    "customerName",
    "text",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}