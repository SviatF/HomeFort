{
  "name": "Abandoned Cart Recovery",
  "description": "\u0427\u0435\u0440\u0435\u0437 2 \u0433\u043e\u0434\u0438\u043d\u0438 \u043f\u0456\u0441\u043b\u044f \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u043e\u0433\u043e \u043a\u043e\u0448\u0438\u043a\u0430 \u2014 email \u0437\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u043e\u0432\u0430\u043d\u043e\u043c\u0443 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0443 \u0430\u0431\u043e callback-\u043b\u0456\u0434 \u043c\u0435\u043d\u0435\u0434\u0436\u0435\u0440\u0443 \u0434\u043b\u044f \u0433\u043e\u0441\u0442\u044f",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "AbandonedCart",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.status == \"pending\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "abandoned_cart_recovery",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "wait_2h": {
          "wait": "PT2H",
          "then": "process",
          "x-base44": {
            "title": "\u0427\u0435\u043a\u0430\u0442\u0438 2 \u0433\u043e\u0434\u0438\u043d\u0438",
            "description": "\u0414\u0430\u0454\u043c\u043e \u0447\u0430\u0441 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438 \u043f\u043e\u043a\u0443\u043f\u043a\u0443"
          }
        }
      },
      {
        "process": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processAbandonedCart",
            "args": {
              "cartId": "${ .trigger.data.cartId }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u041e\u0431\u0440\u043e\u0431\u0438\u0442\u0438 \u043f\u043e\u043a\u0438\u043d\u0443\u0442\u0438\u0439 \u043a\u043e\u0448\u0438\u043a",
            "description": "Email \u0430\u0431\u043e callback-\u043b\u0456\u0434"
          }
        }
      }
    ]
  }
}